    {
      "parameters": {
        "jsCode": "// Schritt 4 – Kennzahlen aus dem Hevy-Workout berechnen\nconst w = $input.first().json;\n\n// Aufwärmsätze zählen NICHT ins Volumen.\n// Umdrehen? -> set.type === 'warmup'\nconst zaehltInsVolumen = (set) => set.type !== 'warmup';\n\n// Volumen = Σ(weight_kg * reps) über alle Arbeitssätze\nlet volumen = 0;\nlet arbeitssaetze = 0;\nfor (const ex of (w.exercises ?? [])) {\n  for (const set of (ex.sets ?? [])) {\n    if (!zaehltInsVolumen(set)) continue;\n    const kg   = set.weight_kg ?? 0;\n    const reps = set.reps ?? 0;\n    volumen += kg * reps;\n    if (kg > 0 && reps > 0) arbeitssaetze++;\n  }\n}\nvolumen = Math.round(volumen);\n\n// Dauer in Minuten\nconst startMs = new Date(w.start_time).getTime();\nconst endMs   = new Date(w.end_time).getTime();\nconst dauerMin = Math.round((endMs - startMs) / 60000);\n\n// Datum lokal (Europe/Berlin) für die spätere Log-Verknüpfung\nconst datum = new Date(w.start_time)\n  .toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' }); // YYYY-MM-DD\n\nreturn [{\n  json: {\n    hevyId: w.id,\n    split:  w.title ?? '',\n    dauerMin,\n    volumen,\n    arbeitssaetze,\n    datum,\n    quelle: 'Hevy',\n  }\n}];"
      },
