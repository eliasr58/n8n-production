      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst metrics = (body.data && body.data.metrics) || [];\nconst get = n => metrics.find(m => m.name === n);\nconst last = a => a && a.length ? a[a.length-1] : null;\n\n// letzter Tag im Datensatz = aktuellster Tag\nconst stepsArr = get('step_count')?.data || [];\nconst datum = (last(stepsArr)?.date || new Date().toISOString()).slice(0,10);\n\nconst onDay = (arr) => (arr||[]).find(d => (d.date||'').slice(0,10) === datum);\n\nconst steps = onDay(get('step_count')?.data);\nconst rhr   = onDay(get('resting_heart_rate')?.data);\nconst wgt   = onDay(get('weight_body_mass')?.data);\nconst slp   = onDay(get('sleep_analysis')?.data);\n\nconst props = {\n  \"Tag\":    { title: [{ text: { content: datum } }] },\n  \"Datum\":  { date: { start: datum } },\n  \"Quelle\": { select: { name: \"Apple Health\" } }\n};\nconst num = (name, v) => { if (v !== null && v !== undefined && !isNaN(v)) props[name] = { number: Math.round(v*10)/10 }; };\nnum(\"Schritte\",      steps ? steps.qty : null);\nnum(\"Ruhepuls (bpm)\",rhr ? rhr.qty : null);\nnum(\"Gewicht (kg)\",  wgt ? wgt.qty : null);\nnum(\"Schlaf (h)\",    slp ? slp.totalSleep : null);\n\nreturn [{ json: {\n  datum,\n  bodyAnlegen: JSON.stringify({ parent: { database_id: \"<NOTION_ID>\" }, properties: props }),\n  bodyUpdate:  JSON.stringify({ properties: props })\n} }];"
      },
