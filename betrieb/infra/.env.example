# /opt/n8n/.env — Vorlage. Echte Werte liegen ausschliesslich auf dem Server
# und im Passwortmanager, niemals im Repository.

# --- Domains ---------------------------------------------------------------
DOMAIN=n8n.example.eu
SITE_DOMAIN=example.eu
ACME_EMAIL=kontakt@example.eu
GENERIC_TIMEZONE=Europe/Berlin

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=<GENERIEREN: openssl rand -base64 32>
POSTGRES_DB=n8n

# --- n8n -------------------------------------------------------------------
# Ohne diesen Schluessel sind wiederhergestellte Credentials wertlos.
# Gehoert zwingend ins Backup UND in den Passwortmanager.
N8N_ENCRYPTION_KEY=<GENERIEREN: openssl rand -hex 32>

# --- basic_auth vor der n8n-Oberflaeche ------------------------------------
# Hash erzeugen mit: caddy hash-password
# Jedes $ im Hash in dieser Datei verdoppeln, sonst interpretiert Compose es
# als Variable und die Direktive bleibt leer.
N8N_UI_USER=<benutzername>
N8N_UI_HASH=<bcrypt-hash>

# --- basic_auth vor dem Statistik-Dashboard --------------------------------
# Bewusst ein eigenes Paar statt derselben Zugangsdaten wie oben: Sonst oeffnet
# ein einziges erratenes Passwort beide Oberflaechen.
STATS_UI_USER=<benutzername>
STATS_UI_HASH=<bcrypt-hash>
