# /opt/n8n/Caddyfile — Röhrner Automation
# Wird als :ro in den Caddy-Container gemountet (siehe docker-compose.yml).
#
# Variablen kommen aus /opt/n8n/.env:
#   DOMAIN        n8n.example.eu
#   SITE_DOMAIN   roehrner.eu
#   ACME_EMAIL    kontakt@roehrner.eu
#   N8N_UI_USER   Benutzername für die n8n-Oberfläche
#   N8N_UI_HASH   bcrypt-Hash dazu (caddy hash-password)

{
	email {$ACME_EMAIL}
}

# ==============================================================
# Website
# ==============================================================
{$SITE_DOMAIN} {
	# HSTS sofort setzen (AZ, 19.10.2026): der header-Block unten wird wegen "-Server"
	# verzoegert und fehlt deshalb auf Fehlerantworten (401, 404, 429).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	root * /srv/site
	encode zstd gzip

	# --- Kontaktformular ---------------------------------------
	# Gleiche Herkunft wie die Seite: der Browser spricht ausschließlich mit
	# roehrner.eu. CORS entfällt damit vollständig, und die bei Safe Browsing
	# gelistete Subdomain kommt im Kundenpfad nicht mehr vor.
	handle /api/kontakt {
		# Nur POST. GET/HEAD auf diesem Pfad ist immer ein Scanner.
		@nichtPost not method POST
		respond @nichtPost "Method Not Allowed" 405

		# 32 KB reichen für jede Anfrage aus diesem Formular. Ohne Grenze
		# nimmt n8n auch ein 1-MB-Feld entgegen und verarbeitet es —
		# nachgemessen am 17.08.2026.
		request_body {
			max_size 32KB
		}

		# Drossel VOR n8n: greift, bevor eine Ausführung startet, und ist
		# nicht auf die statischen Workflow-Daten angewiesen.
		# Zwei rate_limit-Bloecke, IP-Zone zuerst (C167, Auftrag CC, 22.10.2026):
		# In EINEM Block sortiert caddy-ratelimit v0.1.0 die durchlaessigere Zone
		# nach vorn; die globale zaehlte dann auch Anfragen, die die IP-Zone danach
		# abweist, und eine einzige Adresse konnte alle anderen aussperren. Getrennte
		# Bloecke laufen in der Reihenfolge dieser Datei (Pruefstand CB und CC).
		rate_limit {
			zone kontakt_ip {
				key         {remote_host}
				events      3
				window      10m
				ipv6_prefix 56
			}
		}
		rate_limit {
			zone kontakt_global {
				key    static
				events 600
				window 1h
			}
		}

		rewrite * /webhook/kontakt
		reverse_proxy n8n:5678 {
			# Überschreiben, nicht anhängen: sonst steht ein vom Absender
			# mitgeschickter Wert VOR der echten Adresse.
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
		}
	}


	# --- Seite + echte 301 für die vier Alt-Routen --------------
	handle {
		redir /leistungen  /#leistung  permanent
		redir /ueber-mich  /           permanent
		redir /referenzen  /           permanent
		redir /kontakt     /#kontakt   permanent
		file_server
	}

	# Astro baut src/pages/404.astro zu dist/404.html.
	# `file_server` behält hier den Statuscode 404 bei — kein Soft-404.
	# --- Antwort bei Drosselung --------------------------------
	# Ohne diesen Block liefert Caddy bei 429 einen leeren Koerper.
	# Das Formular sucht darin nach "ok" oder "fehler", findet
	# nichts und zeigt die generische Meldung statt des Hinweises
	# mit der Telefonnummer. Gemessen am 23.08.2026.
	# Beide Pfade, weil offen ist, ob rate_limit vor oder nach dem
	# rewrite auf /webhook/kontakt greift.
	handle_errors 429 {
		@kontakt path /api/kontakt /webhook/kontakt
		handle @kontakt {
			header Content-Type "application/json; charset=utf-8"
			respond `{"ok":false,"fehler":["rate_limit"],"hinweis":"Zu viele Anfragen in kurzer Zeit. Bitte in einigen Minuten erneut versuchen oder rufen Sie direkt an: <TELEFON>"}` 429
		}
		handle {
			respond "Too Many Requests" 429
		}
	}

	handle_errors 404 {
		rewrite /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		X-Frame-Options           "DENY"
		Permissions-Policy        "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Die inhaltliche CSP steht als <meta> in jeder Seite (Astro trägt dort
		# die sha256-Hashes seiner Inline-Skripte ein). frame-ancestors wirkt
		# im meta-Tag nicht und muss deshalb hier stehen.
		Content-Security-Policy   "frame-ancestors 'none'"
		-Server
	}

	# 7 Tage — identisch zur Angabe in /datenschutz.
	log {
		output file /var/log/caddy/site.log {
			roll_size     1GiB
			roll_keep     5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp "^(/webhook(?:-test)?/(?:sipgate|seven)-)[^/?]+" "${1}REDACTED"
			}
		}
	}
}

www.{$SITE_DOMAIN} {
	# HSTS auch auf der Umleitung (AZ, 19.10.2026).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# ==============================================================
# n8n
# ==============================================================
# Gemessen am 17.08.2026 gegen den Live-Server:
#   POST /webhook/kontakt  mit {}        -> 400   (Endpunkt offen)
#   POST /webhook/kontakt  mit 200 KB    -> 400   (KEINE Body-Grenze, n8n hat
#                                                  die Nutzlast verarbeitet)
#   GET  /                               -> 200   (Oberflaeche ungeschuetzt)
# Die Haertung auf roehrner.eu/api/kontakt war damit vollstaendig umgehbar:
# 10 statt 3 Anfragen pro 10 Minuten, kein Stundenlimit, keine Groessengrenze.
{$DOMAIN} {
	# HSTS sofort setzen (AZ, 19.10.2026): der header-Block unten wird wegen "-Server"
	# verzoegert und fehlt deshalb auf Fehlerantworten (401 von basic_auth).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# --- Tuer zu ------------------------------------------------
	# Der Kundenpfad laeuft ausschliesslich ueber roehrner.eu/api/kontakt.
	# Dieselbe Funktion hier zusaetzlich offen zu lassen, macht die Grenzen
	# dort wirkungslos. `handle` mit konkretem Pfad sticht das Platzhalter-
	# `handle` darunter, weil Caddy nach Spezifitaet sortiert.
	# -test/ mit abdecken: n8n registriert im Editor-Modus denselben Namen.
	handle /webhook/kontakt {
		respond 404
	}
	handle /webhook-test/kontakt {
		respond 404
	}

	# --- Uebrige Webhooks: dieselben Grenzen wie /api/kontakt ----
	# Seit 27.10.2026 (CJ-2710, Entscheidung Elias) ohne Ausnahmen: die eigenen
	# Bloecke fuer den sipgate-Dispatcher und den SMS-Dialog sind mit dem alten
	# Telefonangebot entfernt. Rueckweg /root/backups/<SICHERUNG>
	@webhook_allgemein {
		path /webhook/*
	}
	handle @webhook_allgemein {
		# Fehlte hier komplett — nachgewiesen mit 200 KB.
		request_body {
			max_size 32KB
		}
		# Zwei rate_limit-Bloecke, IP-Zone zuerst (C167, Auftrag CC, 22.10.2026);
		# Grund beim Block /api/kontakt oben.
		rate_limit {
			zone n8n_webhook_ip {
				key         {remote_host}
				events      10
				window      10m
				ipv6_prefix 56
			}
		}
		rate_limit {
			# Neu: ohne Gesamtgrenze reicht ein Wechsel der Quell-IP
			# (IPv6-Praefix, Botnet), um beliebig oft durchzukommen.
			zone n8n_webhook_global {
				key    static
				events 120
				window 1h
			}
		}
		reverse_proxy n8n:5678 {
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
		}
	}

	# --- Testformulare (n8n "Execute workflow") ohne basic_auth -- 01.10.2026 ---
	# Der Formular-POST von n8n schickt die Basic-Auth-Daten nicht mit -> 401.
	# /form-test/<id> nimmt nur an, solange im Editor ein Testlauf wartet, und genau einmal.
	# /form/* (dauerhafte Formulare) bleibt bewusst hinter basic_auth.
	handle /form-test/* {
		request_body {
			max_size 5MB
		}
		rate_limit {
			zone n8n_formtest_ip {
				key         {remote_host}
				events      20
				window      10m
				ipv6_prefix 56
			}
		}
		reverse_proxy n8n:5678 {
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
		}
	}

	# --- Oberflaeche: nicht mehr oeffentlich --------------------
	# Unabhaengig vom Grund der Safe-Browsing-Listung: ein Login-Formular
	# gehoert nicht offen ins Netz. n8ns eigener Login bleibt dahinter,
	# basic_auth ist die vorgelagerte zweite Schranke.
	# N8N_UI_USER und N8N_UI_HASH in /opt/n8n/.env eintragen,
	# Hash via `caddy hash-password`, jedes $ in der .env verdoppeln.
	handle {
		basic_auth {
			{$N8N_UI_USER} {$N8N_UI_HASH}
		}
		reverse_proxy n8n:5678 {
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
		}
	}

	# Dieselben Schutzheader wie auf der Website — der Site-Block vererbt
	# nicht hierher.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		X-Frame-Options           "DENY"
		-Server
	}

	log {
		output file /var/log/caddy/n8n.log {
			roll_size     1GiB
			roll_keep     5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp "^(/webhook(?:-test)?/(?:sipgate|seven)-)[^/?]+" "${1}REDACTED"
			}
		}
	}
}
